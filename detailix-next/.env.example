# Copier en .env et compléter. Toute variable absente fait basculer la
# fonctionnalité correspondante en mode démonstration explicite (jamais un
# faux succès silencieux) : voir README.md.

# --- Base de données (obligatoire) ---
# SQLite en dev, Postgres en prod (Neon/Supabase) — un seul champ à changer,
# voir prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- URL publique du site (recommandé) ---
# Utilisée pour les canonical/Open Graph/sitemap et les redirections Stripe.
# Sans elle : repli sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Paiement Stripe (optionnel — sans clé, commande marquée payée en démo) ---
STRIPE_SECRET_KEY=""
# Secret du endpoint webhook (Stripe CLI ou Dashboard > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=""

# --- Emails transactionnels Resend (optionnel — sans clé, email loggé seulement) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="commandes@detailix.fr"

# --- Limiteur de débit partagé Upstash Redis (optionnel — sans les deux, repli
# en mémoire du processus Node, non partagé entre instances, voir rateLimit.ts) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Suivi d'erreurs Sentry (optionnel — sans DSN, SDK inactif : aucun
# événement envoyé, ni au build ni à l'exécution, voir instrumentation.ts) ---
SENTRY_DSN=""
# Même DSN, exposé au bundle navigateur (préfixe NEXT_PUBLIC_ requis pour
# atteindre le client) — un DSN Sentry est conçu pour être public (il ne
# permet que de soumettre des événements, jamais de lire des données).
NEXT_PUBLIC_SENTRY_DSN=""
# Optionnels, seulement pour l'upload des source maps au build (org/projet
# Sentry, jeton d'API) — sans eux, les erreurs remontent quand même, juste
# sans code source associé aux traces.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Bootstrap admin (optionnel — sans les deux, aucun compte ADMIN n'est créé) ---
# Lu uniquement par `npm run db:seed`. Permet d'atteindre le back-office sur
# une base fraîche sans insérer un mot de passe par défaut deviné dans le code.
# Idempotent : relancer le seed avec les mêmes valeurs met juste à jour le hash.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
