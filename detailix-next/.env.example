# Copier ce fichier en `.env` puis lancer `npm run setup` (voir README).

# IMPORTANT : mettre un CHEMIN ABSOLU vers detailix-next/prisma/dev.db, pas un chemin
# relatif. Un chemin relatif (file:./dev.db) se résout différemment entre le CLI Prisma
# (relatif à prisma/) et le runtime Next.js (relatif au dossier de lancement du serveur),
# ce qui casse systématiquement l'un des deux avec "Unable to open the database file".
# Exemple Windows :
#   DATABASE_URL="file:C:/chemin/vers/detailix-next/prisma/dev.db"
# Exemple macOS/Linux :
#   DATABASE_URL="file:/chemin/vers/detailix-next/prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Base servant à générer sitemap.xml, robots.txt, les URLs canoniques et les
# données structurées JSON-LD. À remplacer par le vrai domaine avant `next build`
# en production (sinon Google indexera des URLs localhost).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Clé de signature du cookie de 2FA en attente (lib/auth/twofactor.ts). Générer une
# vraie valeur en dev/prod avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-1a2b3c4d5e6f7890"
