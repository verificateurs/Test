{
  "name": "detailix-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "test:e2e": "node tests/e2e.js",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/core": "^10.73.0",
    "@sentry/nextjs": "^10.73.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.1",
    "prisma": "^6.19.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
