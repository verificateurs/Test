generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enum ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  PRO
  ADMIN
}

enum Homologation {
  route_ouverte
  usage_piste
  non_applicable
}

enum Carburant {
  essence
  diesel
  hybride
  electrique
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String  @id
  label       String
  description String
  brands      Brand[]
  products    Product[]
}

model Brand {
  id           String   @id
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  name         String
  origine      String
  gamme        String
  rating       Float
  reviewCount  Int
  recommended  Boolean
  preference   String
  reviews      BrandReview[]
  products     Product[]
}

model BrandReview {
  id       Int     @id @default(autoincrement())
  brandId  String
  brand    Brand   @relation(fields: [brandId], references: [id])
  author   String
  rating   Int
  date     String
  comment  String
}

model Vehicle {
  codeMoteur         String     @id
  marque             String
  modele             String
  motorisation       String
  anneeDebut         Int?
  anneeFin           Int?
  carburant          Carburant?
  cylindreeCm3       Int?
  puissanceOrigineCh Int?
  coupleOrigineNm    Int?
  consoOrigineL100   Float?     // consommation mixte WLTP indicative, L/100km
  stagePacks         StagePack[]

  @@index([marque, modele])
}

// Packs de préparation moteur (Stage 1/2/3) rattachés à un code moteur précis.
// Gains indicatifs uniquement — dépendent du véhicule réel, à valider sur banc
// par un préparateur avant toute installation. `homologation` reprend
// l'enum déjà utilisée sur Product : les stages impliquant une cartographie
// moteur non réceptionnée doivent être `usage_piste`, jamais `route_ouverte`.
model StagePack {
  id                String       @id @default(cuid())
  codeMoteur        String
  vehicle           Vehicle      @relation(fields: [codeMoteur], references: [codeMoteur])
  stage             Int          // 1, 2, 3
  label             String
  description       String
  gainChMin         Int
  gainChMax         Int
  gainNmMin         Int
  gainNmMax         Int
  consoDeltaL100    Float        // variation de conso estimée, L/100km (positif = surconsommation)
  prixIndicatif     Float
  homologation      Homologation
  // JSON: string[] d'id Product inclus dans le pack (même convention que
  // Product.compatibilite : JSON encodé en String plutôt qu'une table de
  // jointure, pour rester cohérent avec le reste du schéma).
  includedProductIds String

  @@index([codeMoteur])
}

model Product {
  id            String        @id
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id])
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  name          String
  format        String
  description   String
  prixAchat     Float
  stockQty      Int           @default(10)
  compatibilite String        // JSON: "universel" | {type:"codesMoteurs",codes:[...]}
  homologation  Homologation?
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       ProductReview[]
}

model ProductReview {
  id               Int      @id @default(autoincrement())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  author           String
  rating           Int
  date             String
  comment          String
  verifiedPurchase Boolean  @default(false)

  @@index([productId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
  wishlist     WishlistItem[]
  passwordResets PasswordResetToken[]
  totpSecret   String?   // 2FA TOTP (admin only), base32-encoded
  totpEnabled  Boolean   @default(false)
}

model Session {
  // id is SHA-256(rawToken) — rawToken lives only in the httpOnly cookie
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256(rawToken)
  expiresAt DateTime
  usedAt    DateTime?
}

// ─── Commerce ─────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          String      @default("pending") // pending | paid | shipped | cancelled
  total           Float
  shippingName    String?
  shippingAddress String?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qty        Int
  unitPrice  Float   // retail price TTC snapshot at order time
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

model Promo {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int       // e.g. 10 = 10%
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   // Markdown
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}
