// Schéma Detailix.
//
// SQLite en développement (aucun compte requis, testable immédiatement).
// En production : passer `provider` à "postgresql" et fournir DATABASE_URL
// (Neon / Supabase). Une seule ligne à changer, aucune requête à réécrire.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Catalogue ----------

model Category {
  id          String    @id
  label       String
  description String
  position    Int       @default(0)
  brands      Brand[]
  products    Product[]
}

model Brand {
  id          String    @id
  name        String
  origine     String
  gamme       String
  rating      Float
  reviewCount Int
  recommended Boolean   @default(false)
  preference  String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  reviews     Review[]
  products    Product[]

  @@index([categoryId])
}

model Review {
  id      Int    @id @default(autoincrement())
  author  String
  rating  Int
  date    String
  comment String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Product {
  id          String  @id
  name        String
  format      String
  description String
  prixAchat   Float // coût HT ; le prix de vente est calculé via Setting.marginPercent
  stock       Boolean @default(true)
  // "universel" ou JSON {"type":"codesMoteurs","codes":[...]}
  compatibilite String @default("universel")
  homologation  String? // route-ouverte | usage-piste | non-applicable
  brandId     String
  categoryId  String
  brand       Brand      @relation(fields: [brandId], references: [id])
  category    Category   @relation(fields: [categoryId], references: [id])
  orderLines  OrderLine[]
  wishlistItems WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
}

// ---------- Véhicules ----------

model VehicleMake {
  id     String         @id
  name   String
  models VehicleModel[]
}

model VehicleModel {
  id            String                @id
  name          String
  makeId        String
  make          VehicleMake           @relation(fields: [makeId], references: [id], onDelete: Cascade)
  motorisations VehicleMotorisation[]

  @@index([makeId])
}

model VehicleMotorisation {
  id         String       @id
  label      String
  codeMoteur String
  modelId    String
  model      VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

// ---------- Comptes & commandes (activés aux modules 4-6) ----------

enum Role {
  CUSTOMER
  PRO
  ADMIN
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  displayName          String
  role                 Role                  @default(CUSTOMER)
  // 2FA (admin uniquement) : totpSecret est renseigné dès la génération du QR
  // code (voir /admin/securite), mais totpEnabled ne passe à true qu'après
  // confirmation d'un code valide — un secret généré mais jamais confirmé
  // n'active jamais la 2FA au login.
  totpSecret           String?
  totpEnabled          Boolean               @default(false)
  createdAt            DateTime              @default(now())
  orders               Order[]
  sessions             Session[]
  wishlistItems        WishlistItem[]
  passwordResetTokens  PasswordResetToken[]
  pendingTwoFactors    PendingTwoFactor[]
}

// Réservée aux utilisateurs connectés (pas de liste d'envies anonyme) — un
// visiteur sans compte est redirigé vers /connexion, comme /compte.
model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Même schéma que Session : id = empreinte SHA-256 du jeton envoyé par email,
// jamais le jeton en clair. TTL court, usage unique (usedAt).
model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// État intermédiaire entre "mot de passe vérifié" et "session créée" quand le
// compte a la 2FA activée. id = empreinte SHA-256 du jeton posé dans un
// cookie temporaire distinct de SESSION_COOKIE. `next` porte la redirection
// d'origine à travers ce détour (perdue sinon, le cookie ?next= n'existant
// que le temps de la requête de connexion).
model PendingTwoFactor {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  next      String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  status        OrderStatus @default(PENDING)
  email         String
  shippingName  String
  shippingAddr  String
  shippingZip   String
  shippingCity  String
  subtotal      Float
  shippingCost  Float       @default(0)
  discount      Float       @default(0)
  total         Float
  promoCode     String?
  stripeSession String?
  createdAt     DateTime    @default(now())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  lines         OrderLine[]

  @@index([userId])
}

model OrderLine {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // figé au moment de l'achat
  format    String
  unitPrice Float
  qty       Int
  lineTotal Float

  @@index([orderId])
}

enum PromoType {
  FIXED
  PERCENT
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  type          PromoType
  value         Float
  minSubtotal   Float     @default(0)
  freeShipping  Boolean   @default(false)
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

// Contenu éditorial (guides), publié directement à la création — pas de
// statut brouillon : plus simple, et un article existant est toujours
// consultable, cohérent avec generateStaticParams qui liste tout Article.
// `content` est du texte brut (paragraphes séparés par une ligne vide),
// jamais du HTML — voir src/lib/blog.ts : la fiche rend chaque paragraphe
// comme enfant texte React (échappé), sans dangerouslySetInnerHTML, pour ne
// pas invalider la CSP script-src 'unsafe-inline' (voir middleware.ts).
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  publishedAt DateTime @default(now())
}
